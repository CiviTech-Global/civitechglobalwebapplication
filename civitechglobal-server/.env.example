# Local development (default): uses your host Postgres / pgAdmin4 and a local or Docker Redis.
# For Docker-only mode, override these in your shell or let docker-compose.yml set the internal URLs.
DATABASE_URL="postgresql://user:password@localhost:5432/civitechglobal?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# PII encryption keys — must be at least 32 characters in production.
# These are used for AES-256-GCM encryption and HMAC search hashes.
PII_ENCRYPTION_KEY="dev-pii-encryption-key-min-32-chars!!"
PII_HMAC_KEY="dev-pii-hmac-key-min-32-chars!!!!!!"
PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Seed Credentials — Super Admin (full access)
# IMPORTANT: No defaults are provided in code. Must be 12-128 characters and include uppercase, lowercase, number, and special character.
ADMIN_EMAIL=superadmin@civitechglobal.com
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# Reverse proxy trust setting for Express (number of proxies, comma-separated IPs, or true/false).
# Default is 1 when unset. Set to the actual proxy topology in production.
TRUST_PROXY=1

# Seed Credentials — Admin (limited CRUD access)
# IMPORTANT: Must be 12-128 characters and include uppercase, lowercase, number, and special character.
DEMO_ADMIN_EMAIL=admin@civitechglobal.com
DEMO_ADMIN_PASSWORD=""
DEMO_ADMIN_FIRST_NAME=Manager
DEMO_ADMIN_LAST_NAME=Admin

# Seed Credentials — Normal User
# IMPORTANT: Must be 12-128 characters and include uppercase, lowercase, number, and special character.
USER_EMAIL=user@civitechglobal.com
USER_PASSWORD=""
USER_FIRST_NAME=Demo
USER_LAST_NAME=User

# Demo Data — optional shared password for demo users.
# If set, must be 12-128 characters and include uppercase, lowercase, number, and special character.
# If left empty, a compliant random password is generated automatically.
DEMO_PASSWORD=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling              # polling or webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ADMIN_USER_IDS=               # comma-separated Telegram user IDs
TELEGRAM_BOT_PORT=4000
TELEGRAM_WEBHOOK_SECRET=               # secret token for webhook validation

# Observability
SENTRY_DSN=
METRICS_ENABLED=false
LOG_LEVEL=info
