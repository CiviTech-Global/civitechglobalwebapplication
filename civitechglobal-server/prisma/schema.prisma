generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum OpportunityType {
  JOB
  INTERNSHIP
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model AdminRole {
  id          String    @id @default(cuid())
  name        String    @unique
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]

  @@index([deletedAt])
  @@map("admin_roles")
}

model User {
  id             String    @id @default(cuid())
  // email, firstName, lastName, and phone are encrypted at rest via application-layer encryption.
  email          String
  emailHash      String?   @unique @map("email_hash")
  username       String?   @unique
  password       String
  firstName      String
  lastName       String
  role           Role      @default(USER)
  permissions    String[]  @default([])
  avatar         String?
  phone          String?
  phoneHash      String?   @map("phone_hash")
  emailVerified  Boolean   @default(false)
  adminRoleId    String?
  tokenVersion   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  adminRole               AdminRole?              @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  orders                  Order[]
  tickets                 Ticket[]
  ticketMessages          TicketMessage[]
  opportunityApplications OpportunityApplication[]
  refreshTokens           RefreshToken[]

  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([emailHash])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String
  price          Float?
  image          String?
  category       String?
  features       String[]
  githubUrl      String?
  landingPageUrl String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  orderItems OrderItem[]

  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("products")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  price       Float?
  image       String?
  category    String?
  serviceType String?   @default("CUSTOM")
  features    String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("services")
}

model Opportunity {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String
  requirements    String[]
  duration        String
  location        String
  type            String          @default("Remote")
  opportunityType OpportunityType @default(INTERNSHIP)
  isOpen          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  applications OpportunityApplication[]

  @@index([isOpen])
  @@index([opportunityType])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("opportunities")
}

model OpportunityApplication {
  id            String            @id @default(cuid())
  userId        String
  opportunityId String
  coverLetter   String
  resumeUrl     String?
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([status])
  @@index([createdAt])
  @@map("opportunity_applications")
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Float
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String?
  subject   String
  // email is encrypted at rest.
  email     String
  emailHash String?        @map("email_hash")
  category  String?        @default("SUPPORT")
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([emailHash])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  content   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_messages")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model InsuranceCategory {
  id            String               @id @default(cuid())
  title         String               @unique
  emoji         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subcategories InsuranceSubcategory[]
  leads         Lead[]

  @@map("insurance_categories")
}

model InsuranceSubcategory {
  id         String            @id @default(cuid())
  categoryId String
  title      String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  category   InsuranceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  leads      Lead[]

  @@unique([categoryId, title])
  @@index([categoryId])
  @@map("insurance_subcategories")
}

model Lead {
  id                   String     @id @default(cuid())
  telegramUserId       String     @map("telegram_user_id")
  // telegramUsername, telegramFirstName, fullName, phoneNumber, and city are encrypted at rest.
  telegramUsername     String?    @map("telegram_username")
  telegramFirstName    String?    @map("telegram_first_name")
  categoryId           String     @map("category_id")
  subcategoryId        String     @map("subcategory_id")
  fullName             String     @map("full_name")
  phoneNumber          String     @map("phone_number")
  phoneNumberHash      String?    @map("phone_number_hash")
  city                 String
  preferredContactTime String     @map("preferred_contact_time")
  notes                String?
  status               LeadStatus @default(NEW)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  category    InsuranceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory InsuranceSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdAt])
  @@index([phoneNumberHash])
  @@map("leads")
}
